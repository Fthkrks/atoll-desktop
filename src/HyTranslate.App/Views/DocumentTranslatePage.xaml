<Page
    x:Class="HyTranslate.App.Views.DocumentTranslatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HyTranslate.App.Controls"
    xmlns:vm="using:HyTranslate.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Stretch">

            <!-- Drag & Drop Zone -->
            <Border
                x:Name="DropZone"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="Dosyayı buraya sürükleyin veya seçin"
                        FontSize="18"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Desteklenen formatlar: .docx, .pptx, .xlsx, .pdf, .txt, .md"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />
                    <Button
                        Content="Dosya seç"
                        Click="ChooseFile_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Height="36" />
                </StackPanel>
            </Border>

            <!-- Selected File Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="32" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SelectedFileName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.SelectedFileSize, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedFileType, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="ClearSelectedFile_Click"
                        ToolTipService.ToolTip="Kaldır"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Save Location Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Kayıt yeri:"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.OutputFilePath, Mode=OneWay}"
                        IsReadOnly="True"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ViewModel.OutputFilePath, Mode=OneWay}" />

                    <Button
                        Grid.Column="2"
                        Content="Değiştir…"
                        Click="ChangeOutputPath_Click"
                        IsEnabled="{x:Bind ViewModel.IsTranslating, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        VerticalAlignment="Center"
                        Height="32" />
                </Grid>
            </Border>

            <!-- Language Selection & Translate Controls -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:LanguageSelectorControl
                    Grid.Column="0"
                    SourceLanguages="{x:Bind ViewModel.SourceLanguages, Mode=OneWay}"
                    SelectedSourceLanguage="{x:Bind ViewModel.SelectedSourceLanguage, Mode=TwoWay}"
                    TargetLanguages="{x:Bind ViewModel.TargetLanguages, Mode=OneWay}"
                    SelectedTargetLanguage="{x:Bind ViewModel.SelectedTargetLanguage, Mode=TwoWay}"
                    SwapCommand="{x:Bind ViewModel.SwapLanguagesCommand, Mode=OneWay}"
                    CanSwap="{x:Bind ViewModel.CanSwap, Mode=OneWay}" />

                <Button
                    Grid.Column="1"
                    Content="Çevir"
                    Command="{x:Bind ViewModel.TranslateDocumentCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Height="36"
                    Margin="8,0,0,0" />

                <Button
                    Grid.Column="2"
                    Content="İptal"
                    Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                    Height="36"
                    Margin="8,0,0,0" />
            </Grid>

            <!-- Progress Section -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsTranslating, Mode=OneWay}">
                <ProgressBar
                    Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                    Minimum="0"
                    Maximum="100"
                    IsIndeterminate="False"
                    Height="8" />
                <TextBlock
                    Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Success InfoBar with Open / Reveal buttons -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                Severity="Success"
                Title="Çeviri Tamamlandı"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Dosyayı aç" Command="{x:Bind ViewModel.OpenFileCommand, Mode=OneWay}" />
                        <Button Content="Klasörde göster" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- Warning InfoBar -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                Severity="Warning"
                Title="Uyarılar">
                <InfoBar.Content>
                    <ListView ItemsSource="{x:Bind ViewModel.Warnings, Mode=OneWay}" SelectionMode="None" Margin="0,8,0,0" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Error InfoBar -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Hata"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>
