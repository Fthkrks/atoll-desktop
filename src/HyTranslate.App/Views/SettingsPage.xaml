<Page
    x:Class="HyTranslate.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:HyTranslate.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">

            <!-- Title -->
            <TextBlock Text="Ayarlar" FontSize="28" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <ComboBox Header="Çeviri altyapısı (Backend)" ItemsSource="{x:Bind ViewModel.Backends}" SelectedItem="{x:Bind ViewModel.Backend, Mode=TwoWay}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.BuiltInVisibility, Mode=OneWay}">
                        <TextBox Header="GGUF model dosyası (boşsa paketteki model)" Text="{x:Bind ViewModel.EmbeddedModelPath, Mode=TwoWay}" />
                        <Button Content="Model dosyası seç…" Click="BrowseEmbeddedModel_Click" />
                        <TextBlock Text="{x:Bind ViewModel.ResolvedModelPath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.ModelLoadStatus, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="Test · Hello → Türkçe" Command="{x:Bind ViewModel.TestConnectionCommand}" IsEnabled="{x:Bind ViewModel.IsTesting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.TestResultMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Model Location Card -->
            <Border
                Visibility="{x:Bind ViewModel.OllamaVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Model Konumu ve Yerel Sunucu" FontSize="18" FontWeight="SemiBold" />

                    <!-- Model Location (OLLAMA_MODELS) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Header="Model konumu (OLLAMA_MODELS)"
                            Text="{x:Bind ViewModel.ModelsPath, Mode=TwoWay}"
                            PlaceholderText="Örn. D:\ollama\models — boş bırakılırsa çalışan Ollama kullanılır" />
                        <Button
                            Grid.Column="1"
                            Content="Gözat…"
                            VerticalAlignment="Bottom"
                            Height="32"
                            Click="BrowseModelsPath_Click" />
                    </Grid>

                    <!-- Managed Port -->
                    <NumberBox
                        Header="Uygulamanın Ollama portu"
                        Value="{x:Bind ViewModel.ManagedPortDouble, Mode=TwoWay}"
                        SpinButtonPlacementMode="Inline"
                        SmallChange="1"
                        LargeChange="10"
                        Minimum="1024"
                        Maximum="65535" />

                    <!-- Ollama Exe Path -->
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="ollama.exe yolu (isteğe bağlı)"
                                Text="{x:Bind ViewModel.OllamaExePath, Mode=TwoWay}"
                                PlaceholderText="Boş bırakılırsa otomatik bulunur" />
                            <Button
                                Grid.Column="1"
                                Content="Gözat…"
                                VerticalAlignment="Bottom"
                                Height="32"
                                Click="BrowseOllamaExe_Click" />
                        </Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.OllamaExeHint, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Save & Start Server Button -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button
                            Content="Kaydet ve Ollama'yı başlat"
                            Command="{x:Bind ViewModel.SaveAndStartServerCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsStartingServer, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="36" />
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsStartingServer, Mode=OneWay}"
                            Width="20"
                            Height="20" />
                    </StackPanel>

                    <!-- Status line -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerStatusText, Mode=OneWay}"
                        Foreground="{x:Bind ViewModel.ServerStatusBrush, Mode=OneWay}"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Ollama Card -->
            <Border
                Visibility="{x:Bind ViewModel.OllamaVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Ollama Sunucu Ayarları" FontSize="18" FontWeight="SemiBold" />

                    <!-- Ollama URL -->
                    <StackPanel Spacing="4">
                        <TextBox
                            Header="Ollama Adresi"
                            Text="{x:Bind ViewModel.OllamaUrl, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsOllamaUrlEnabled, Mode=OneWay}"
                            PlaceholderText="http://localhost:11434" />
                        <TextBlock
                            Text="Model konumu ayarlıyken uygulama kendi sunucusunu kullanır"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.OllamaUrlNoteVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Model Name (ComboBox) -->
                    <ComboBox
                        Header="Model Adı"
                        IsEditable="True"
                        Text="{x:Bind ViewModel.ModelName, Mode=TwoWay}"
                        ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="maternion/hy-mt2:1.8b" />

                    <!-- Test Connection Button & Status -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button
                            Content="Bağlantıyı test et"
                            Command="{x:Bind ViewModel.TestConnectionCommand, Mode=OneWay}"
                            Height="36" />
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}"
                            Width="20"
                            Height="20" />
                        <TextBlock
                            Text="{x:Bind ViewModel.TestResultMessage, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Download Model -->
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <Button
                            Content="Modeli indir"
                            Command="{x:Bind ViewModel.DownloadModelCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            Height="36" />

                        <ProgressBar
                            Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                            Minimum="0"
                            Maximum="100"
                            IsIndeterminate="False"
                            Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}"
                            Height="8" />

                        <TextBlock
                            Text="{x:Bind ViewModel.DownloadStatusText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Document Translation Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Belge Çevirisi" FontSize="18" FontWeight="SemiBold" />

                    <ToggleSwitch
                        Header="PDF'lerdeki görsellerin içindeki metni de çevir (OCR)"
                        IsOn="{x:Bind ViewModel.OcrEnabled, Mode=TwoWay}" />

                    <StackPanel Spacing="4">
                        <ComboBox
                            Header="OCR dili"
                            MinWidth="240"
                            ItemsSource="{x:Bind ViewModel.OcrLanguagesList, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedOcrLanguageItem, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName" />
                        <TextBlock
                            Text="Yüklü OCR dili yok"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="{x:Bind ViewModel.NoOcrLanguagesNoteVisibility, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Görünüm" FontSize="18" FontWeight="SemiBold" />

                    <ComboBox
                        x:Name="ThemeComboBox"
                        Header="Uygulama Teması"
                        MinWidth="200"
                        SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Sistem (Varsayılan)" Tag="System" />
                        <ComboBoxItem Content="Açık Tema" Tag="Light" />
                        <ComboBoxItem Content="Koyu Tema" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button
                Content="Ayarları Kaydet"
                Command="{x:Bind ViewModel.SaveSettingsCommand, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Height="36"
                Padding="24,0" />

            <TextBlock Text="Atoll 1.0.0 · 4pp Studio&#xA;Çevrimdışı metin ve belge çevirisi · Tencent HY-MT2 1.8B&#xA;Üçüncü taraf lisansları: uygulama klasöründeki LICENSES dizini." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        </StackPanel>
    </ScrollViewer>
</Page>
